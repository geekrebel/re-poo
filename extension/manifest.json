{
  "manifest_version": 3,
  "name": "RE-Poo",
  "version": "2.3.0",
  "description": "Fixes real estate search results: hide Retirement Living and other unwanted listings, show monthly prices next to weekly rents.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.realestate.com.au/*",
        "https://www.domain.com.au/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.domain.com.au/*"
      ],
      "js": [
        "map-agent.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.realestate.com.au/*"
      ],
      "js": [
        "rea-agent.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["villages.json"],
      "matches": [
        "https://www.domain.com.au/*",
        "https://www.realestate.com.au/*"
      ]
    }
  ]
}